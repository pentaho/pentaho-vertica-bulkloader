<?xml version="1.0" encoding="UTF-8"?>
<transformation>
  <info>
    <name>PDI-20182 Janino long binary</name>
    <directory>/</directory>
    <trans_type>Normal</trans_type>
    <size_rowset>100</size_rowset>
    <parameters/>
  </info>
  <connection>
    <name>Vertica QA loader</name>
    <server>vertica-hostname</server>
    <type>VERTICA5</type>
    <access>Native</access>
    <database>vmart</database>
    <port>5433</port>
    <username>qa_loader</username>
    <password>qa_ephemeral</password>
    <attributes><attribute><code>PORT_NUMBER</code><attribute>5433</attribute></attribute></attributes>
  </connection>
  <order>
    <hop><from>Read source</from><to>Convert to UTF-8</to><enabled>Y</enabled></hop>
    <hop><from>Convert to UTF-8</from><to>Load long types</to><enabled>Y</enabled></hop>
  </order>
  <step>
    <name>Read source</name>
    <type>TableInput</type>
    <distribute>Y</distribute><copies>1</copies>
    <connection>Vertica QA loader</connection>
    <sql>SELECT source_id, source_text AS Last FROM public.qa_long_source ORDER BY source_id</sql>
    <limit>0</limit><execute_each_row>N</execute_each_row>
    <variables_active>N</variables_active><lazy_conversion_active>N</lazy_conversion_active>
    <GUI><xloc>100</xloc><yloc>80</yloc><draw>Y</draw></GUI>
  </step>
  <step>
    <name>Convert to UTF-8</name>
    <type>Janino</type>
    <distribute>Y</distribute><copies>1</copies>
    <formula>
      <field_name>LongBin</field_name>
      <formula_string>Last == null ? null : Last.getBytes("UTF-8")</formula_string>
      <value_type>Binary</value_type><value_length>-1</value_length><value_precision>-1</value_precision>
      <replace_field/>
    </formula>
    <GUI><xloc>260</xloc><yloc>80</yloc><draw>Y</draw></GUI>
  </step>
  <step>
    <name>Load long types</name>
    <type>VerticaBulkLoader</type>
    <distribute>Y</distribute><copies>1</copies>
    <connection>Vertica QA loader</connection>
    <schema>public</schema><table>qa_target</table>
    <specify_fields>Y</specify_fields>
    <fields>
      <field><column_name>payload_binary</column_name><stream_name>LongBin</stream_name></field>
      <field><column_name>payload_text</column_name><stream_name>Last</stream_name></field>
      <field><column_name>id</column_name><stream_name>source_id</stream_name></field>
    </fields>
    <exceptions_filename/><rejected_data_filename/>
    <abort_on_error>Y</abort_on_error><direct>Y</direct>
    <stream_name>PDI-20182</stream_name>
    <GUI><xloc>420</xloc><yloc>80</yloc><draw>Y</draw></GUI>
  </step>
  <step_error_handling/>
</transformation>